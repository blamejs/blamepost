# Deny all dotfiles by default; allow-list specific ones below.
# Catches .env*, .aws/, .ssh/, .npmrc-with-tokens, .vscode/, .idea/,
# .bash_history, .DS_Store, editor and tooling scratch, and anything
# else that conventionally lives in a dotfile we don't intend to ship.
.*

# Dotfiles we DO want tracked
!.gitignore
!.gitattributes
!.github/
!.clusterfuzzlite/
!.editorconfig
!.dockerignore
!.hadolint.yaml
!.nvmrc
!.npmrc
!.gitleaks.toml
!.pinact.yaml
!.semgrep/

# Build / dependencies
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Runtime / logs
*.log
*.pid
*.pid.lock
tmp/

# Mail-server runtime state. A data directory holds live mail, account
# credentials and sealed DKIM private keys. It must never reach a commit,
# whether it sits at the default container path or a developer's local
# override.
data/
var/lib/blamepost/
var/log/blamepost/
blobs/
queue/
tlsrpt/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# ACME account + issued certificate material fetched at runtime.
acme/
tls/

# OS junk (non-dotfile)
Thumbs.db
desktop.ini

# Editor scratch (non-dotfile)
*.swp
*.swo
*~

# Credential and key material. Belt-and-braces over the dotfile deny rule.
#
# The two extensions this server writes itself are named here rather than
# left to the directory rules below. A sealed DKIM private key is
# `<domain>.<selector>.<algorithm>.sealed` and the database is `db.enc`,
# and both were covered only by the NAME of the directory they usually sit
# in. A data directory called anything else put them inside a clone: `keys/
# a.sealed`, `db.enc` and `mydata/db.enc` were all trackable, and the
# release path is `git add -A`.
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.sealed
*.enc
secrets.json
credentials.json
id_rsa*
id_ed25519*

# Published trust material and test vectors opt back in explicitly. The
# blanket rules above guard against committing OPERATOR-PRIVATE material;
# anything that ships with the package re-allows itself here.
!keys/*.json
!test/fixtures/*.pem
!test/fixtures/*.crt
!test/fixtures/**/*.pem
!test/fixtures/**/*.crt

# Backup / patch artifacts
*.bak
*.orig
*.rej

# Dev lockfiles ARE committed so CI's `npm ci` pins the reviewed dev-tool
# versions with integrity hashes and OpenSSF Scorecard sees a pinned
# install. This does NOT relax the zero-npm-runtime-deps rule. The server
# ships zero runtime deps (blamejs is vendored under lib/vendor/); these
# lockfiles are development-only and are excluded from the published
# tarball's `files` allowlist.

# CycloneDX SBOM, generated by the publish workflow at release time and
# bundled into the tarball. Never committed.
sbom.cdx.json
sbom.vendored.cdx.json

# Local-only release tooling. gen-changelog runs against an operator's
# clone, and CHANGELOG.md ships curated from the release commit.
scripts/gen-changelog.js

# Maintainer-local design notes and internal specs. GOVERNANCE.md
# references memory/specs/ as maintainer-local; the operator-facing
# roadmap lives in ROADMAP.md.
memory/

# Test-runner diagnostics (sync-fd persisted, read on failure).
.test-output/

# Fuzzer-discovered corpus entries (libFuzzer writes 40-hex, extensionless
# inputs back into the seed dir during a local run) are NOT tracked; only
# the curated seeds, which all carry an extension, are committed. This
# keeps a release-time `git add -A` from sweeping generated inputs in.
fuzz/*_seed_corpus/*
!fuzz/*_seed_corpus/*.*

# The reproducer a fuzz run writes when it finds something. libFuzzer puts
# it in the directory the run started from, which for the documented
# command is the repository root, so it lands beside the tracked files
# rather than under fuzz/. The release path is `git add -A`, and a
# reproducer is an input that crashed a parser: it belongs in the finding's
# issue, not in the tree.
crash-*
leak-*
timeout-*
oom-*
slow-unit-*

# The vendored framework is the artifact operators consume, so every byte of
# it is tracked. Three patterns above are unanchored and reach into it: `.*`
# hides the data-verification public key, `*.pem` hides the BIMI trust
# anchor, and `sbom.cdx.json` hides the framework's own bill of materials.
# A clone missing any of them carries a different vendored tree than the
# tarball ships, which makes the integrity gate fail for everyone who did
# not vendor it themselves and quietly weakens two verification paths. This
# must stay last, because a later rule wins.
#
# One re-include per file that needs one, rather than the whole subtree. A
# later rule wins, so `!lib/vendor/**` does not put three files back: it
# cancels every rule above it for everything under that prefix, and the
# environment file, private key, registry configuration and database
# ignored everywhere else become trackable there. `lib/` ships in the
# tarball, so they would reach the registry as well as the repository, and
# a path re-included this way is one the pack guard reads as deliberate.
#
# A vendor refresh that adds a fourth file matching a rule above needs a
# line here. It announces itself: the file is missing from the clone, and
# the vendored-tree hash stops matching the manifest.
!lib/vendor/**/.vendor-data-pubkey
!lib/vendor/**/*.pem
!lib/vendor/**/sbom.cdx.json
