# EditorConfig: https://editorconfig.org
# Matches the settled conventions: 2-space JS, LF, UTF-8, trimmed.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Vendored bundles are pinned by SHA-256 in lib/vendor/MANIFEST.json.
# Never reformat them.
[lib/vendor/**]
trim_trailing_whitespace = false
insert_final_newline = false

# Fuzz seeds are the exact bytes a wire-protocol reader is handed. A
# trailing space is part of a command, and a final newline appended by an
# editor turns a well-formed line into one the guard refuses for a bare
# LF, which would cost the corpus the accept path it was written for.
[fuzz/*_seed_corpus/**]
trim_trailing_whitespace = false
insert_final_newline = false
