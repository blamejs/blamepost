{
  "name": "@blamejs/blamepost",
  "version": "0.1.0",
  "description": "Self-hosted mail server that owns its stack: SMTP, IMAP, JMAP, POP3, ManageSieve and webmail in one container. PQC-first, zero runtime deps.",
  "license": "Apache-2.0",
  "author": "blamejs contributors",
  "homepage": "https://github.com/blamejs/blamepost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blamejs/blamepost.git"
  },
  "bugs": {
    "url": "https://github.com/blamejs/blamepost/issues"
  },
  "main": "lib/index.js",
  "bin": {
    "blamepost": "bin/blamepost.js"
  },
  "keywords": [
    "mail-server",
    "smtp",
    "imap",
    "jmap",
    "webmail",
    "self-hosted",
    "post-quantum",
    "dkim",
    "dmarc",
    "mta-sts",
    "nodejs",
    "zero-dependencies",
    "container"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "files": [
    "bin/",
    "lib/",
    "docs/",
    "docker/",
    "Dockerfile",
    "compose.yml",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE",
    "LTS-CALENDAR.md",
    "MIGRATING.md",
    "NOTICE",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SUPPORT.md",
    "THREAT-MODEL.md",
    "sbom.cdx.json"
  ],
  "scripts": {
    "test": "node test/smoke.js",
    "integration": "node scripts/test-integration.js",
    "lint": "eslint --max-warnings 0 .",
    "gates": "node scripts/run-gates.js \"node test/layer-0-primitives/codebase-patterns.test.js\" \"node scripts/validate-source-comment-blocks.js\" \"node scripts/check-api-snapshot.js\" \"node scripts/check-spelling-consistency.js\" \"node scripts/check-status-lifecycle.js\" \"node scripts/check-node-floor.js\" \"node scripts/check-vendor-integrity.js\" \"node scripts/pin-all.js --check\"",
    "check:prose": "node scripts/check-operator-prose.js",
    "check:prose:all": "node -e \"process.env.BLAMEPOST_PROSE_CHECKS='all';var r=require('child_process').spawnSync(process.execPath,['scripts/check-operator-prose.js'],{stdio:'inherit'});if(r.error)throw r.error;process.exit(r.signal?1:r.status)\"",
    "check:spelling": "node scripts/check-spelling-consistency.js",
    "check:swallows": "node scripts/check-swallow-coverage.js",
    "check:vendor-currency": "node scripts/check-vendor-currency.js",
    "check:actions-currency": "node scripts/check-actions-currency.js",
    "coverage": "c8 --include=lib/** --include=bin/** --exclude=lib/vendor/** --reporter=text-summary --reporter=lcov node test/smoke.js",
    "coverage:gated": "npm run coverage && npm run check:swallows",
    "coverage:unified": "node scripts/coverage-unified.js",
    "coverage:unified:gated": "npm run coverage:unified && npm run check:swallows",
    "prepack": "node scripts/check-pack-against-gitignore.js",
    "vendor": "bash scripts/vendor-update.sh",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "eslint": "10.10.0"
  }
}
